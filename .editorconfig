# https://editorconfig.org
# Matches the project's black/ruff config (line length 100, Python 3.12) and the
# 2-space YAML used by suites and evalkit.yaml.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.py]
indent_size = 4
max_line_length = 100

[*.{yaml,yml}]
indent_size = 2

[*.toml]
indent_size = 4

[*.md]
# Markdown uses trailing whitespace for hard line breaks.
trim_trailing_whitespace = false
